# ─── Application ─────────────────────────────────────────────────────────────
APP_PORT=3002
PUBLIC_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=proxy_db
DB_DEBUG=false

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_password
MAIL_NO_REPLY_FROM_EMAIL=noreply@proxyservice.com
MAIL_NO_REPLY_FROM_NAME=ProxyService
MAIL_SUPPORT_FROM_EMAIL=support@proxyservice.com
MAIL_SUPPORT_FROM_NAME=ProxyService Support

# ─── eKYC (Bank verification for shop onboarding) ────────────────────────────
EKYC_API_BANK_LIST=
EKYC_API_BANK_LOOKUP=
EKYC_API_KEY=
EKYC_API_SECRET=

# ─── Pay2S (Payment gateway) ──────────────────────────────────────────────────
PAY2S_QR_LINK=
PAY2S_BANK_CODE=
PAY2S_BANK_NUMBER=
PAY2S_BANK_NAME=
PAY2S_WEBHOOK_SECRET_KEY=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Facebook OAuth ───────────────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Webshare Proxy ───────────────────────────────────────────────────────────
# Cấu hình được lưu trong database (bảng proxy_pools)
# Có thể override bằng env:
# WEBSHARE_API_KEY=your_webshare_api_key

# ─── 2Captcha (dùng khi Webshare yêu cầu reCAPTCHA) ─────────────────────────
# WEBSHARE_RECAPTCHA_2CAPTCHA_API_KEY=

# ─── Proxy Scheduler ─────────────────────────────────────────────────────────
# Khoảng thời gian retry pending orders (ms), mặc định 60000 = 1 phút
PROXY_PENDING_SYNC_INTERVAL_MS=60000
# Số lượng pending orders xử lý mỗi lần
PROXY_PENDING_RETRY_BATCH_SIZE=10
# Thời gian chờ trước khi retry (ms)
PROXY_PENDING_RETRY_DELAY_MS=60000
# Số lần retry tối đa
PROXY_PENDING_MAX_ATTEMPTS=3

# ─── Proxy Pricing ────────────────────────────────────────────────────────────
# Bật/tắt markup giá proxy (true/false)
PROXY_PRICE_APPLY_MARKUP=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOGGER_VERBOSE=false

# ─── Blog view deduplication ─────────────────────────────────────────────────
BLOG_VIEW_UNIQUE_MINUTES=5
